# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Twilio WhatsApp notification: optional. If any of these are missing,
# the app works normally and simply skips the "new lead" WhatsApp notice.
# Auth: either TWILIO_AUTH_TOKEN (classic) OR TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET
# (Twilio API Key, starts with SK...). TWILIO_ACCOUNT_SID (starts with AC...) is
# always required regardless of which auth method you use.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="whatsapp:+39XXXXXXXXXX"

